<?xml version="1.0" encoding="utf-8"?>
<!-- 登录令牌与保险箱机密对应 iOS 的 ThisDeviceOnly：不进云备份、不进设备迁移。
     本地数据（提醒、记账生活账本、灵感、常用语）可以随备份走。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="umbra_secure.xml" />
        <exclude domain="file" path="vault" />
        <exclude domain="sharedpref" path="umbra_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="umbra_secure.xml" />
        <exclude domain="file" path="vault" />
        <exclude domain="sharedpref" path="umbra_vault.xml" />
    </device-transfer>
</data-extraction-rules>
